APP_NAME="SKINKU B2B Distributor Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# DATABASE (SQL is the single source of truth — no Firestore/Firebase)
# Default: MySQL / MariaDB (XAMPP). To use PostgreSQL switch DB_CONNECTION=pgsql
# and DB_PORT=5432 (enable the pdo_pgsql PHP extension first).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skinku_b2b
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MAIL (forgot/reset password emails). MAIL_MAILER=log writes to storage logs
# during development. Configure SMTP for production.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@skinku.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# INITIAL SUPER ADMIN (consumed by SuperAdminSeeder — never hardcoded in code)
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME="Super Admin SKINKU"
SUPER_ADMIN_EMAIL="superadmin@skinku.id"
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ---------------------------------------------------------------------------
# OPTIONAL — only if AI features are reintroduced later
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GOOGLE_AI_STUDIO_ENV=  # note: legacy deploy target was Google AI Studio / Cloud Run

VITE_APP_NAME="${APP_NAME}"

# TikTok Shop Open API (Custom app) — isi di server, JANGAN commit nilai asli
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# Shopee Open Platform (Custom app) — isi di server, JANGAN commit nilai asli
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Chat push: "Live Push Partner Key" (di-generate di halaman Set Push Shopee) —
# untuk verifikasi tanda tangan push, BEDA dari SHOPEE_PARTNER_KEY.
SHOPEE_PUSH_PARTNER_KEY=
# Setel true SEMENTARA saat setup Push (Fase 0): push diterima tanpa verifikasi
# + direkam ke log. Matikan lagi setelah tanda tangan terkonfirmasi.
SHOPEE_PUSH_DEBUG=false

# Portal Content Creator — Meta App (FB Page + Instagram) & Threads API. Isi di server.
# Redirect URI OAuth: {APP_URL}/social-connections/meta/callback & /social-connections/threads/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
THREADS_APP_ID=
THREADS_APP_SECRET=
# TikTok Content Posting API (app "SKINKU Content Portal" di developers.tiktok.com).
# Redirect URI: {APP_URL}/social-connections/tiktok/callback
TIKTOK_CONTENT_CLIENT_KEY=
TIKTOK_CONTENT_CLIENT_SECRET=
# Email kontak yang tampil di halaman publik /privacy & /terms.
LEGAL_CONTACT_EMAIL=

# Report Bot Telegram (webhook + notifikasi laporan via chat) — isi di server,
# JANGAN commit nilai asli. webhook_secret harus sama dgn secret_token yang
# dipasang saat setWebhook di BotFather (lihat config/services.php).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Agen scraper KOL (Fase 3c) — app lokal Iyuro/skinku setor transaksi affiliate
# ke portal. Isi token acak panjang di server; app lokal kirim di header
# X-Agent-Token. Kosong = endpoint agen mati (401). JANGAN commit nilai asli.
KOL_AGENT_TOKEN=

# Rekomendasi AI (Discovery) — pencarian web untuk cari KOL & tren produk.
# Butuh TAVILY_API_KEY (daftar gratis di tavily.com) + OPENAI_API_KEY (perangkum,
# sudah dipakai Asisten AI). Isi di server, JANGAN commit nilai asli.
TAVILY_API_KEY=

# Cadangan AI berlapis (opsional). Slot ke-2/3: kosongkan KEY/BASE untuk mewarisi
# dari AI_BACKUP_* (mis. model lain di akun 9router yang sama → cukup isi MODEL).
# Aktif hanya bila (KEY hasil-warisan) & MODEL terisi. Urutan: OpenAI → 1 → 2 → 3.
# Cadangan-1 (OpenAI-compatible: OpenRouter/9router/DeepSeek/Groq). BASE default OpenRouter.
AI_BACKUP_KEY=
AI_BACKUP_BASE=
AI_BACKUP_MODEL=
AI_BACKUP2_KEY=
AI_BACKUP2_BASE=
AI_BACKUP2_MODEL=
AI_BACKUP3_KEY=
AI_BACKUP3_BASE=
AI_BACKUP3_MODEL=
