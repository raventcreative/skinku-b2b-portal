APP_NAME="Jurnal AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite = default (nol konfigurasi). Ganti ke mysql untuk produksi.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jurnal_ai
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ── Otak AI ────────────────────────────────────────────────────────────────
# WAJIB model yang bisa "lihat" gambar (vision) untuk foto struk & screenshot
# mutasi. Model teks-saja tetap bisa dipakai untuk teks tempel dan PDF yang
# teksnya bersih, tapi foto akan gagal dibaca.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=4000
AI_REQUEST_TIMEOUT=120
AI_CONNECT_TIMEOUT=10

# Nama parameter batas keluaran. 'max_tokens' diterima hampir semua endpoint;
# model penalaran OpenAI terbaru menuntut 'max_completion_tokens'. Salah pilih
# tidak fatal — sistem menukarnya otomatis kalau endpoint menolak.
AI_TOKEN_PARAM=max_tokens

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Pakai router pihak ketiga (9router / OpenRouter / Groq / DeepSeek / Together)?
# Semuanya OpenAI-compatible: cukup ganti KEY + BASE + MODEL di tiga baris di
# atas, AI_PROVIDER tetap 'openai'. Contoh:
#   OPENAI_API_KEY=<key dari dashboard router>
#   OPENAI_API_BASE=https://<host-router>/v1
#   AI_MODEL=<id model persis seperti tertulis di katalog router>
# Pastikan modelnya berlabel vision / VL / multimodal kalau mau baca foto struk.

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Otak cadangan — dipakai otomatis kalau primary kehabisan kuota / down.
# Endpoint apa pun yang OpenAI-compatible (OpenRouter, Groq, DeepSeek, Together).
AI_BACKUP_KEY=
AI_BACKUP_BASE=https://openrouter.ai/api/v1
AI_BACKUP_MODEL=
AI_BACKUP_TIMEOUT=120

# Batas aman upload dokumen (KB).
INTAKE_MAX_UPLOAD_KB=12288
