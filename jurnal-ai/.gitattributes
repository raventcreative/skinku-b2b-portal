* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Berkas Windows WAJIB berakhiran CRLF. Dengan LF, label dan goto di .bat
# bisa tidak terbaca dan peluncurnya gagal jalan di komputer pengguna.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
